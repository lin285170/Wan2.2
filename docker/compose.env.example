# Copy to .env in repo root (same directory as docker-compose.yml) and adjust.
#
# ===== BOTH NODES (must match) =====

# Required: at least one API key (comma-separated for multiple)
WAN_SERVE_API_KEYS=sk-change-me

# Model weights on host (bind-mount into worker at /ckpt)
WAN_CKPT_HOST_PATH=/data/Wan2.2-T2V-A14B

# torchrun topology: 2 nodes × 4 GPUs per node = 8 GPUs total
WAN_NNODES=2
WAN_NPROC_PER_NODE=4

# Master node IP (both nodes must agree on this for NCCL rendezvous)
# On master: use 0.0.0.0 to listen on all interfaces
# On worker: use the actual master IP (e.g. 10.0.0.1)
WAN_MASTER_ADDR=10.0.0.1
WAN_MASTER_PORT=29500

# Published API port on host (master node only)
WAN_API_PORT=8008

# ===== MASTER NODE ONLY =====

# Redis is local on master — containers use redis://redis:6379/0

# ===== WORKER NODE ONLY =====

# Redis URL pointing to master node (replace MASTER_IP with actual IP)
# WAN_REDIS_URL=redis://10.0.0.1:6379/0