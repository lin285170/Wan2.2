# Copy to ../.env in repo root (same directory as docker-compose.yml) and adjust.

# Required: at least one key (comma-separated for multiple)
WAN_SERVE_API_KEYS=sk-change-me

# Model weights on host (bind-mount into worker at /ckpt). Required for real jobs.
# For API-only smoke tests you may point to an empty directory:
WAN_CKPT_HOST_PATH=/data/Wan2.2-T2V-A14B

# Published API port on host
WAN_API_PORT=8008

# torchrun topology (single container = one machine; use 8 for one DGX-style node)
WAN_NNODES=1
WAN_NPROC_PER_NODE=8

# Multi-node from one worker container: SSH to second GPU host (optional)
# WAN_SSH_SECOND_NODE=ubuntu@10.0.0.12
